# ============================================================================
# KARTULI DECK AI — Environment Configuration (.env.example)
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Configuration
# Obtain your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Supported Gemini Image Models (verified against https://ai.google.dev/gemini-api/docs/image-generation):
# - gemini-nano-banana-2.1 (Recommended default Nano Banana 2.1 workhorse)
# - gemini-3-pro-image (Nano Banana Pro - highest precision & creative control)
# - gemini-3.1-flash-image (Nano Banana 2)
# - gemini-3.1-flash-lite-image (Nano Banana 2 Lite - fastest & lowest cost)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2

# Database Configuration (PostgreSQL)
# If DATABASE_URL is omitted in local development, an embedded PostgreSQL-compatible
# database engine with persistent file snapshot (.data/kartuli-deck-db.json) is used automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kartuli_deck_ai

# Queue Configuration (BullMQ + Redis)
# If REDIS_URL is omitted in local development, the persistent database-backed queue worker runs automatically.
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2

# Object Storage Configuration (S3-Compatible: AWS S3, Cloudflare R2, MinIO, Supabase Storage)
# Set STORAGE_DRIVER=s3 in production (e.g., Render) to persist generated card assets in object storage.
# Set STORAGE_DRIVER=local for local development only (.data/storage).
STORAGE_DRIVER=local
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=kartuli-deck-assets
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_PUBLIC_URL_BASE=https://kartuli-deck-assets.s3.amazonaws.com

# Security & Cost Controls
MAX_DECK_SIZE=54
USER_DAILY_GENERATION_LIMIT=200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
SESSION_SECRET=kartuli_deck_luxury_studio_secret_change_in_prod
